# ----------------------------------------------------------------------------
# ローカル環境 (Mac) の設定
# ----------------------------------------------------------------------------

export BAT_THEME="ansi"
export DISPLAY=:0
alias install_kitty="curl -L https://sw.kovidgoyal.net/kitty/installer.sh | sh /dev/stdin"
path=($HOME/.local/lib/npm/bin "/Applications/kitty.app/Contents/MacOS" $path)
path=($HOME/.local/bin $path)

# Launch Claude through cmux's wrapper so cmux's notification hooks are injected.
# cmux defines the same function, but `exec zsh` drops it. Use /bin/bash because
# MacPorts bash 5.3.20 segfaults on ${var#pattern} in UTF-8 locales.
unalias claude 2>/dev/null
claude() {
  local cmux_claude_wrapper="/Applications/cmux.app/Contents/Resources/bin/cmux-claude-wrapper"
  if [[ -n "${CMUX_SURFACE_ID:-}" && -x "$cmux_claude_wrapper" ]]; then
    /bin/bash "$cmux_claude_wrapper" "$@"
  else
    command claude "$@"
  fi
}

# Skip cmux's per-invocation Codex hooks so hook trust checks stay enabled.
# cmux notifications come from the persistent hooks in ~/.codex/hooks.json.
# Do not set CMUX_CODEX_HOOKS_DISABLED=1: those hooks exit early on it, and the
# wrapper then strips every CMUX_* variable they need.
# To re-enable per-invocation hooks, run
# /Applications/cmux.app/Contents/Resources/bin/cmux-codex-wrapper here instead.
codex() {
  command codex "$@"
}

replace_all() {
  if [ $# -ne 2 ]; then
    echo "使用方法: replace_all <置換前の文字列> <置換後の文字列>"
    return 1
  fi
  grep -rl "$1" . | xargs sed -i '' "s/$1/$2/g"
}

alias -g noc='nocorrect'

