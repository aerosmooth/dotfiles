# ----------------------------------------------------------------------------
# ローカル環境 (Mac) の設定
# ----------------------------------------------------------------------------

export BAT_THEME="ansi"
export DISPLAY=:0
alias install_kitty="curl -L https://sw.kovidgoyal.net/kitty/installer.sh | sh /dev/stdin"
path=($HOME/.local/lib/npm/bin /Applications/kitty.app/ Contents/MacOS $path)
path=($HOME/.local/bin $path)

# Disable cmux's per-invocation Codex hooks so hook trust checks stay enabled.
export CMUX_CODEX_HOOKS_DISABLED=1

# Keep the cmux wrapper available for easy re-enabling.
# CMUX_CODEX_HOOKS_DISABLED makes it pass through to the normal Codex command.
codex() {
  local cmux_codex_wrapper="/Applications/cmux.app/Contents/Resources/bin/cmux-codex-wrapper"
  if [[ -n "${CMUX_SURFACE_ID:-}" && -x "$cmux_codex_wrapper" ]]; then
    /bin/bash "$cmux_codex_wrapper" "$@"
  else
    command codex "$@"
  fi
}

replace_all() {
  if [ $# -ne 2 ]; then
    echo "使用方法: replace_all <置換前の文字列> <置換後の文字列>"
    return 1
  fi
  grep -rl "$1" . | xargs sed -i '' "s/$1/$2/g"
}

alias -g noc='nocorrect'

